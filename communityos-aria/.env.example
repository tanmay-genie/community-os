# ── ARIA's own DB (society tables: amenities, bookings, events, dues, notices) ──
# Owned by ARIA after the T2T extraction. T2T no longer holds society tables.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/communityos
REDIS_URL=redis://localhost:6379/0

# ── T2T Backend ──────────────────────────────────────────────
T2T_BASE_URL=http://localhost:8000
T2T_ADMIN_SECRET=your-admin-secret-here

# ── LiveKit (voice pipeline) ─────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ── LLM ──────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-api-key

# ── STT / TTS ────────────────────────────────────────────────
SARVAM_API_KEY=your-sarvam-api-key

# ── MCP Server ───────────────────────────────────────────────
MCP_SERVER_PORT=9000
ARIA_SERVER_NAME=ARIA
APP_ENV=development

# ── Production Security (required when APP_ENV=production) ───
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# HS256 shared secret for JWT Bearer tokens (min 32 chars random)
JWT_SECRET=
JWT_ISSUER=communityos-aria
JWT_EXPIRY_HOURS=24

# ── Twin API keys (override defaults in prod) ────────────────
TWIN_KEY_TANMAY=tanmay-key-001
TWIN_KEY_OPS=ops-key-001
TWIN_KEY_ARIA=aria-key-001

# ── AI features (optional) ───────────────────────────────────
# Embeddings-based intent classifier + RAG (install extras: pip install .[ai])
ARIA_USE_EMBEDDINGS=true
ARIA_USE_RAG=true
ARIA_USE_PROMPT_CACHE=true
ARIA_USE_LLM_MODERATION=true
ARIA_USE_LLM_TRIAGE=true
# Set to "pgvector" to persist RAG chunks in Postgres (requires migration + optional vector ext)
ARIA_RAG_BACKEND=

# ── Per-twin Gemini quotas ───────────────────────────────────
ARIA_QUOTA_DAILY_USD=1.00
ARIA_QUOTA_DAILY_CALLS=500
ARIA_QUOTA_BURST_CALLS_PER_MIN=60
ARIA_QUOTA_ADMIN_EXEMPT=true
