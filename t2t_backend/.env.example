# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/t2t_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/t2t_db

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=generate-a-strong-random-secret-here
LOG_LEVEL=INFO

# ── Admin ─────────────────────────────────────────────
ADMIN_SECRET=generate-a-strong-admin-secret-here

# ── Idempotency ───────────────────────────────────────
IDEMPOTENCY_TTL_SECONDS=86400

# ── SLA ───────────────────────────────────────────────
DEFAULT_ESCALATION_SLA_MINUTES=60

# ── WebSocket ─────────────────────────────────────────
WS_AUTH_TIMEOUT_SECONDS=10

# ── Loop Detection ────────────────────────────────────
LOOP_DETECTION_MAX_HOPS=20

# ── LLM (optional — for AI processor) ────────────────
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini
